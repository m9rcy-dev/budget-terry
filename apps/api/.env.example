DATABASE_URL="postgresql://budget_terry:budget_terry@localhost:5432/budget_terry_dev"
API_PORT=3001
LOG_LEVEL=info
# Origin the web app is served from — CORS rejects requests from anywhere else.
WEB_ORIGIN=http://localhost:3000

# Signs access tokens (ADR-011). Must be at least 32 characters. Generate
# your own for real use — e.g. `openssl rand -base64 48`. Never commit a
# real value.
AUTH_SECRET="replace-with-a-random-value-at-least-32-characters-long"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Email (passwordless login codes). Local dev points at the Mailpit
# container from docker-compose.yml — no credentials needed, and caught
# mail is viewable at http://localhost:8025. In production, set
# MAIL_PROVIDER=resend and RESEND_API_KEY (or swap in a different
# MailProvider implementation in src/mail/mail.module.ts).
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM="Budget Terry <no-reply@budgetterry.local>"
LOGIN_CODE_TTL_MINUTES=10
DEVICE_TRUST_TTL_DAYS=90
