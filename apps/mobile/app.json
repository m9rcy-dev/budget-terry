{
  "expo": {
    "name": "Budget Terry",
    "slug": "budget-terry",
    "scheme": "budgetterry",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetterry.app"
    },
    "android": {
      "package": "com.budgetterry.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
